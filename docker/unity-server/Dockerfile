FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    lib32gcc-s1 \
    libstdc++6 \
    libglu1-mesa \
    libxcursor1 \
    libxrandr2 \
    libxinerama1 \
    libxi6 \
    libnss3 \
    libasound2 \
    libglib2.0-0 \
    libgconf-2-4 \
  && rm -rf /var/lib/apt/lists/*

ENV HOME=/root \
    XDG_CONFIG_HOME=/root/.config \
    UNITY_LOG_PATH=/home/deploy/server/server.log

WORKDIR /home/deploy/server

# Copy the dedicated server build produced by Unity. Expected contents:
# - BanCuLiServer.x86_64 (executable)
# - BanCuLiServer_Data/ (data folder)
# - any other files generated by the headless build
COPY docker/unity-server/build/ /home/deploy/server/

RUN mkdir -p /root/.config/unity3d/GameNhaLam/ServerGame \
  && chmod +x /home/deploy/server/BanCuLiServer.x86_64

EXPOSE 27015

ENTRYPOINT ["./BanCuLiServer.x86_64"]
CMD ["-batchmode", "-nographics", "-dedicatedServer", "1", "-logfile", "/home/deploy/server/server.log"]
